# ====================================================
# PayTrack Backend Environment Configuration
# ====================================================

# Server Configuration
PORT=8080

# Database Configuration (Choose 'postgres' or 'sqlite')
DB_DRIVER=postgres
DB_DSN=host=postgres user=postgres password=postgres dbname=paytrack port=5432 sslmode=disable
DB_PATH=./paytrack.db

# Multi-User Concurrency (Number of parallel mailbox worker goroutines)
SYNC_WORKERS=5

# Authentication & Security Keys (Change in production!)
JWT_SECRET=your-32-byte-jwt-secret-key-here
ENCRYPTION_KEY=your-32-byte-aes-encryption-key-!

# Default / Fallback IMAP Email Configuration
IMAP_SERVER=imap.gmail.com:993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
FETCH_BATCH_SIZE=50
LOOKBACK_DAYS=7

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=30

# Scheduler Configuration (Cron: 4 times a day)
CRON_SCHEDULE=0 0,6,12,18 * * *
CRON_ENABLED=true
